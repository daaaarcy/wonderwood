{
  "name": "wonderwood",
  "private": true,
  "version": "0.1.0",
  "description": "Wonderwood — Theodore & Leonard's Island. A kids' habit-adventure web game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "VITE_BACKEND=local npm run build && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "pretest": "node scripts/sync-shared.mjs",
    "deploy:game": "node scripts/deploy-game.mjs",
    "smoke:supabase": "node scripts/sync-shared.mjs && node scripts/smoke-supabase.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
